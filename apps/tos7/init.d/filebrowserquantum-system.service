[Unit]
Description=FileBrowser Quantum WebUI service
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=filebrowser-quantum
WorkingDirectory=/usr/local/filebrowser-quantum
ExecStart=/usr/bin/python3 /usr/local/filebrowser-quantum/bin/filebrowser-quantum-service
ExecStopPost=-/bin/rm -f /var/api/filebrowser-quantum.sock
EnvironmentFile=-/usr/local/filebrowser-quantum/filebrowser-quantum.env
TimeoutStartSec=30
TimeoutStopSec=10
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes

# Keep only sandbox directives verified across the TOS 7.0 and 7.1 kernels.
# Several stricter directives accepted by Ubuntu systemd are rejected by some
# TOS 7.0 kernels with status=203/EXEC before the process can start.
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
NoNewPrivileges=true

# /var/api is a shared TOS directory and must remain writable for the
# application-owned Unix socket. PrivateTmp is intentionally omitted.
# /Volume1 is the real TOS 7 volume root used for user file sources. Extra
# volumes and the legacy /mnt layout are optional so a missing path cannot
# make the whole service fail with 226/NAMESPACE. Do not set Group=<appid>.
ReadWritePaths=/usr/local/filebrowser-quantum/data /usr/local/filebrowser-quantum/logs /var/api -/Volume1 -/Volume2 -/Volume3 -/Volume4 -/Volume5 -/Volume6 -/Volume7 -/Volume8 -/Volume9 -/mnt
LimitNOFILE=65536
LimitNPROC=512
MemoryMax=1G
CPUQuota=75%
[Install]
WantedBy=multi-user.target
