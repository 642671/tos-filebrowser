[en-us]
name = "FileBrowser Quantum"
auth = "qishiyi"
descript = "Manage NAS files in the browser with previews and sharing. This app wraps official FileBrowser Quantum for TOS."
release_note = "2.0.3: Rectified per review comments. TOS wrapper revision only, still based on official FileBrowser Quantum v2.0.2-stable binaries. Add an in-package privacy policy and remove app data and the service user on uninstall, without deleting files on NAS volume mounts."
important = "This app is a TOS wrapper of official FileBrowser Quantum (Apache-2.0) and does not claim upstream copyright. The first-run admin password is stored in /usr/local/filebrowser-quantum/data/INITIAL_ADMIN.txt; change it after login."

