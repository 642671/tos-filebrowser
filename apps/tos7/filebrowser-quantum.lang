[zh-cn]
name = "FileBrowser Quantum"
auth = "qishiyi"
descript = "在浏览器里管理 NAS 文件，支持预览与分享。本应用是官方 FileBrowser Quantum 的 TOS 套壳。"
release_note = "2.0.3：按审核意见整改。仅更新 TOS 套壳，上游仍是官方 FileBrowser Quantum v2.0.2-stable 二进制。包内增加隐私政策，卸载时清理本应用配置、数据和服务用户，不会删除 NAS 数据盘上的用户文件。"
important = "本应用是官方 FileBrowser Quantum（Apache-2.0）的 TOS 套壳，不会声称拥有上游著作权。首次启动的管理员账号与密码写在 /usr/local/filebrowser-quantum/data/INITIAL_ADMIN.txt，请登录后立即修改。"

[zh-hk]
name = "FileBrowser Quantum"
auth = "qishiyi"
descript = "在瀏覽器裡管理 NAS 檔案，支援預覽與分享。本應用是官方 FileBrowser Quantum 的 TOS 套殼。"
release_note = "2.0.3：按審核意見整改。只更新 TOS 套殼，上游仍是官方 FileBrowser Quantum v2.0.2-stable 二進位檔。套件內增加私隱政策，解除安裝時清理本應用配置、數據和服務用戶，不會刪除 NAS 資料碟上的用戶檔案。"
