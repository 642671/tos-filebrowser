[en-us]
name = "FileBrowser Quantum"
auth = "qishiyi"
descript = "Manage NAS files in the browser with previews and sharing. This is the TOS 7 wrapper of official FileBrowser Quantum v2.0.2-stable (package 2.0.4)."
release_note = "2.0.4: Fixes the store review blockers. Ships the webui.bz2 frontend and extracts it from postinst, corrects the TOS portal /v2/proxy base path, grants write access to /Volume1 and other volumes, removes the hard /mnt requirement, and implements graceful shutdown. Also completes the privacy policy, help link and build provenance. Upstream remains official FileBrowser Quantum v2.0.2-stable."
important = "This app is a TOS wrapper of official FileBrowser Quantum (Apache-2.0) and does not claim upstream copyright. The first-run admin password is stored in /usr/local/filebrowser-quantum/data/INITIAL_ADMIN.txt; change it after login."

