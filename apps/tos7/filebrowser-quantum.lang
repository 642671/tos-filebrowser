[zh-cn]
name = "FileBrowser Quantum"
auth = "qishiyi"
descript = "在浏览器里管理 NAS 文件，支持预览与分享。本应用是官方 FileBrowser Quantum v2.0.2-stable 的 TOS 7 套壳（软件包 2.0.4）。"
release_note = "2.0.4：修复上架审核阻断项。补齐 webui.bz2 前端资源并由安装脚本解压，修正 TOS 门户 /v2/proxy 路径，放开 /Volume1 等卷的可写权限，去掉 /mnt 硬依赖并实现优雅停止；同时完善隐私政策、帮助链接和构建来源说明。上游仍为官方 FileBrowser Quantum v2.0.2-stable。"
important = "本应用是官方 FileBrowser Quantum（Apache-2.0）的 TOS 套壳，不会声称拥有上游著作权。首次启动的管理员账号与密码写在 /usr/local/filebrowser-quantum/data/INITIAL_ADMIN.txt，请登录后立即修改。"

